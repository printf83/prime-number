{
	"compilerOptions": {
		"target": "ES2025",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["DOM", "ES2025"],
		"ignoreDeprecations": "6.0",
		"strict": false,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmitOnError": false,
		"rootDir": "src",
		"outDir": "dist",
		"allowJs": false,
		"moduleResolution": "bundler"
	},
	"include": ["src/**/*.ts"]
}
